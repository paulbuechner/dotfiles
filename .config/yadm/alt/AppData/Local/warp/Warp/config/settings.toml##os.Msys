[system]
prefer_low_power_gpu = true

[appearance]

[appearance.text]
notebook_font_size = 14.0
font_size = 14.0
font_weight = "normal"
match_ai_font = true
match_notebook_to_monospace_font_size = true
font_name = "Berkeley Mono Nerd Font"
line_height_ratio = 1.2000000476837158
ai_font_name = "Berkeley Mono Nerd Font"
ligature_rendering_enabled = true
enforce_minimum_contrast = "only_named_colors"

[appearance.cursor]
cursor_display_type = "block"

[appearance.window]
override_opacity = 70
override_blur_texture = true
zoom_level = 100

[appearance.themes]
selected_system_themes = {
  dark = { custom_base_16 = { name = "Base16 Grayscale Dark", path = "base16_grayscale_dark.yaml" } },
  light = { custom_base_16 = { name = "Base16 Grayscale Light", path = "base16_grayscale_light.yaml" } },
}
system_theme = true

[appearance.vertical_tabs]
enabled = true

[agents]
cloud_conversation_storage_enabled = true

[agents.warp_agent]
 
[agents.warp_agent.input]
nld_in_terminal_enabled = true

[privacy]
telemetry_enabled = false
crash_reporting_enabled = false

[terminal]

[terminal.input]
honor_ps1 = false
input_box_type_setting = "universal"

[account]
is_settings_sync_enabled = false

[notifications]
toast_duration_secs = 8

[notifications.preferences]
is_agent_task_completed_enabled = true
is_long_running_enabled = true
is_needs_attention_enabled = true
is_password_prompt_enabled = true
long_running_threshold = 30
mode = "dismissed"
play_notification_sound = true

[general]
default_session_mode = "terminal"
show_warning_before_quitting = false

[session]

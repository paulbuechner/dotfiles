#!/bin/sh
# Run via `yadm bootstrap`; also offered automatically after `yadm clone`.
#
# yadm execs this with a plain environment: no YADM_* variables, GIT_DIR unset,
# and `yadm` itself is not guaranteed to be on PATH yet.

YADM=$(command -v yadm || echo "$HOME/.yadm-project/yadm")

case "$(uname -s)" in
MINGW* | MSYS* | CYGWIN*)
  # Windows cannot create symlinks without elevation, so alternates must be copies.
  "$YADM" config yadm.alt-copy true

  # There is no Windows package for yadm, so put a shim for the source clone on PATH.
  if [ ! -x "$HOME/bin/yadm" ] && [ -x "$HOME/.yadm-project/yadm" ]; then
    mkdir -p "$HOME/bin"
    printf '#!/bin/sh\nexec "$HOME/.yadm-project/yadm" "$@"\n' >"$HOME/bin/yadm"
    chmod +x "$HOME/bin/yadm"
  fi

  # Warp reads custom themes from a per-platform directory: ~/.warp/themes on
  # macOS, but %APPDATA%\warp\Warp\data\themes here. Note that is Roaming, while
  # settings.toml lives under Local. The repo keeps one copy at ~/.warp/themes,
  # which macOS reads in place, so mirror it rather than committing each theme
  # twice. Without this the theme names in settings.toml resolve to nothing and
  # Warp silently falls back to a built-in theme.
  if [ -d "$HOME/.warp/themes" ]; then
    if [ -n "$APPDATA" ] && command -v cygpath >/dev/null; then
      warp_themes="$(cygpath -u "$APPDATA")/warp/Warp/data/themes"
    else
      warp_themes="$HOME/AppData/Roaming/warp/Warp/data/themes"
    fi
    mkdir -p "$warp_themes" && cp -f "$HOME"/.warp/themes/*.yaml "$warp_themes"/
  fi

  # Modules the PowerShell profiles depend on. Installed rather than vendored so
  # each machine gets DLLs matching its own .NET runtime, and so no binaries end
  # up in git history. On a bare machine PowerShellGet may prompt once to install
  # the NuGet provider.
  if command -v pwsh >/dev/null; then
    pwsh -NoProfile -Command '
      $modules = @{ Pester = "5.7.1"; PSReadLine = "2.3.6" }
      foreach ($name in $modules.Keys) {
        $want = [version]$modules[$name]
        $have = Get-Module -ListAvailable -Name $name |
                Sort-Object Version -Descending | Select-Object -First 1
        if (-not $have -or $have.Version -lt $want) {
          Write-Host "Installing $name >= $want"
          Install-Module $name -MinimumVersion $want -Scope CurrentUser -Force
        }
      }
    '
  fi
  ;;
esac

# Machine role drives ##class.* alternates. Stored in the repo's git config,
# so it stays machine-local and never travels with the dotfiles.
if [ -z "$("$YADM" config --get local.class)" ]; then
  printf 'local.class for this machine (e.g. Work, Personal): '
  read -r class
  if [ -n "$class" ]; then
    "$YADM" config local.class "$class"
  fi
fi

# Materialise alternates and templates now that os/class are known.
"$YADM" alt
